generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ======================================================
// CONTACT
// ======================================================

model Contact {
  id        Int      @id @default(autoincrement())
  fullName  String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())

}

// ======================================================
// AUTHENTICATION
// ======================================================

model StudentAccount {
  id                 Int     @id @default(autoincrement())
  studentId          Int     @unique
  passwordHash       String
  mustChangePassword Boolean @default(true)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

}

model Admin {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  fullName     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  notices Notice[]

  @@map("admins")
}

// ======================================================
// NOTICES
// ======================================================

enum NoticeCategory {
  GENERAL
  ACADEMIC
  EXAM
  ADMISSION
  EVENT
}

model Notice {
  id            Int            @id @default(autoincrement())
  title         String
  body          String
  category      NoticeCategory @default(GENERAL)
  attachmentUrl String?
  isPinned      Boolean        @default(false)
  isPublished   Boolean        @default(true)
  publishedAt   DateTime       @default(now())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  createdById   Int?

  createdBy Admin? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([isPublished, isPinned, publishedAt])
  @@map("notices")
}

// ======================================================
// ENUMS
// ======================================================

enum ExamType {
  REGULAR
  BACKLOG
}

enum ResultStatus {
  DRAFT
  PUBLISHED
}

enum ResultAction {
  CREATE
  UPDATE
  PUBLISH
  UNPUBLISH
  RECOGNIZE
}

// ======================================================
// DEPARTMENT
// ======================================================

model Department {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String   @unique
  createdAt DateTime @default(now())

  students  Student[]
  curricula Curriculum[]

  @@map("departments")
}

// ======================================================
// ACADEMIC YEAR / ADMISSION COHORT
// ======================================================

model AcademicYear {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime @default(now())

  students Student[]

  @@map("academic_years")
}

// ======================================================
// STUDENT
// ======================================================

model Student {
  id                 Int      @id @default(autoincrement())
  registrationNumber String   @unique
  fullName           String
  departmentId       Int
  admissionYearId    Int
  semester           Int
  profileImageUrl    String ?
  profileImageKey    String ? 
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  admissionYear AcademicYear @relation(fields: [admissionYearId], references: [id], onDelete: Restrict)

  account        StudentAccount?
  enrollments    ExamEnrollment[]
  subjectRecords StudentSubjectRecord[]

  @@index([departmentId, admissionYearId])
}

// ======================================================
// CURRICULUM
// ======================================================

model Curriculum {
  id           Int      @id @default(autoincrement())
  name         String
  version      String
  departmentId Int
  createdAt    DateTime @default(now())

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  subjects   CurriculumSubject[]

  @@unique([departmentId, name, version])
  @@map("curricula")
}

// ======================================================
// SUBJECT
// ======================================================

model Subject {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  creditHours Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  curricula      CurriculumSubject[]
  results        Result[]
  studentRecords StudentSubjectRecord[]

  @@map("subjects")
}

// ======================================================
// SUBJECTS INCLUDED IN A CURRICULUM
// ======================================================

model CurriculumSubject {
  id           Int  @id @default(autoincrement())
  curriculumId Int
  subjectId    Int
  semester     Int
  fullMarks    Int  @default(100)
  passMarks    Int?

  curriculum Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Restrict)
  subject    Subject    @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([curriculumId, semester, subjectId])
  @@index([curriculumId, semester])
  @@map("curriculum_subjects")
}

// ======================================================
// EXAMINATION PERIOD
// ======================================================

model ExamPeriod {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())

  exams Exam[]

  @@map("exam_periods")
}

// ======================================================
// EXAMINATION
// ======================================================

model Exam {
  id           Int      @id @default(autoincrement())
  name         String
  semester     Int
  examType     ExamType
  examPeriodId Int
  createdAt    DateTime @default(now())

  examPeriod ExamPeriod @relation(fields: [examPeriodId], references: [id], onDelete: Restrict)
  enrollments ExamEnrollment[]
  publication ResultPublication?

  @@index([examPeriodId, semester, examType])
  @@map("exams")
}

// ======================================================
// STUDENT EXAMINATION ENROLLMENT
// ======================================================

model ExamEnrollment {
  id        Int      @id @default(autoincrement())
  studentId Int
  examId    Int
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Restrict)
  results Result[]

  @@unique([studentId, examId])
  @@index([examId])
  @@map("exam_enrollments")
}

// ======================================================
// RESULTS: ONE RECORD PER ENROLLED STUDENT AND SUBJECT
// ======================================================

model Result {
  id            Int      @id @default(autoincrement())
  enrollmentId  Int
  subjectId     Int
  marksObtained Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enrollment  ExamEnrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  subject     Subject               @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  auditLogs   ResultAudit[]
  recognizedFor StudentSubjectRecord? @relation("RecognizedResult")

  @@unique([enrollmentId, subjectId])
  @@index([subjectId])
  @@map("results")
}

// ======================================================
// EXAMINATION RESULT PUBLICATION
// ONE PUBLICATION RECORD PER EXAM
// ======================================================

model ResultPublication {
  id          Int          @id @default(autoincrement())
  examId      Int          @unique
  status      ResultStatus @default(DRAFT)
  publishedAt DateTime?
  publishedBy Int?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  exam Exam @relation(fields: [examId], references: [id], onDelete: Restrict)

  @@map("result_publications")
}

// ======================================================
// RESULT CURRENTLY RECOGNIZED FOR GPA
// HISTORY IS PRESERVED IN Result
// ======================================================

model StudentSubjectRecord {
  id                 Int      @id @default(autoincrement())
  studentId          Int
  subjectId          Int
  recognizedResultId Int      @unique
  updatedAt          DateTime @updatedAt

  student          Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  subject          Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  recognizedResult Result  @relation("RecognizedResult", fields: [recognizedResultId], references: [id], onDelete: Restrict)

  @@unique([studentId, subjectId])
  @@map("student_subject_records")
}

// ======================================================
// RESULT AUDIT HISTORY
// ======================================================

model ResultAudit {
  id        Int          @id @default(autoincrement())
  resultId  Int
  action    ResultAction
  oldMarks  Float?
  newMarks  Float?
  reason    String?
  adminId   Int?
  createdAt DateTime     @default(now())

  result Result @relation(fields: [resultId], references: [id], onDelete: Restrict)

  @@index([resultId, createdAt])
  @@map("result_audit")
}
